# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets never committed)
.env*
# ...but the secret-free template IS committed so fresh clones know what to set
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Python virtual environments
venv/
.venv/
env/

# SQLite database (runtime-generated, never commit)
backend/formix.db
*.db
*.sqlite3

# Respondent-uploaded files (runtime-generated, never commit)
backend/uploads/
# Compiled binaries (C++ build artifacts)
*.exe
*.o
*.obj
*.out
forml-compiler/build/

# Unit test build output (node --test fixtures compiled via tests/tsconfig.json)
tests/.build/

# OS
.DS_Store
Thumbs.db