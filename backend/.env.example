# Formix backend environment template.
# Copy this file to backend/.env and fill in real values:
#     cp backend/.env.example backend/.env
# backend/.env is gitignored — never commit real secrets.

# ── AI provider (OpenAI-compatible) ───────────────────────────────────────────
# The Formix AI router speaks the OpenAI /chat/completions protocol, so any
# compatible provider works. Set AI_API_KEY or GEMINI_API_KEY to use one of
# these free tiers:
#
#   Gemini (recommended — generous no-card free tier: ~1M TPM, ~1500 req/day)
#     Get a key: https://aistudio.google.com/apikey
#     GEMINI_API_KEY=<gemini key>          # shorthand; maps to Gemini defaults
#     AI_API_KEY=<gemini key>              # or this long form
#     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     AI_MODEL=gemini-3.6-flash
#
#   Cerebras (same llama-3.3-70b as Groq, 1M tokens/day free):
#     Get a key: https://cloud.cerebras.ai
#     AI_API_KEY=<cerebras key>
#     AI_BASE_URL=https://api.cerebras.ai/v1
#     AI_MODEL=llama-3.3-70b
#
#   Local Ollama (fully free/offline, no key):
#     AI_API_KEY=ollama          # any non-empty value satisfies the key check
#     AI_BASE_URL=http://localhost:11434/v1
#     AI_MODEL=qwen2.5:14b
#
# Optional tuning (defaults shown):
# AI_TEMPERATURE=0.3
# AI_MAX_TOKENS=4096
#
# Legacy: if GROQ_API_KEY is set and neither AI_API_KEY nor GEMINI_API_KEY is,
# the router falls back to Groq with the GROQ_* variables below.
GROQ_API_KEY=

# JWT signing secret — any long random string.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FORMIX_JWT_SECRET=

# How long auth tokens live (minutes). Defaults to 60 if unset.
FORMIX_JWT_EXPIRE_MINUTES=43200

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty to use the local SQLite fallback (backend/formix.db).
# For Postgres (local or Neon), set your connection string, e.g.:
#   DATABASE_URL=postgresql://user:password@localhost:5432/formix
#   DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call the API.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 when unset.
# ALLOWED_ORIGINS=https://formix.vercel.app

# The frontend's base URL, used by the backend when it needs to send the
# browser somewhere (OAuth callback redirect, password-reset links).
# Locally: http://localhost:3000   In prod: https://<your-vercel-app>.vercel.app
FRONTEND_URL=http://localhost:3000

# ── OAuth "Continue with Google / GitHub" ────────────────────────────────────
# Create the credentials, then set these in backend/.env (local) or in the
# Render dashboard (prod). The provider callback URLs must match:
#   Google : https://<backend>/auth/oauth/google/callback
#   GitHub : https://<backend>/auth/oauth/github/callback
# (Add http://localhost:8000/... variants in the provider dashboards to test
# locally too. GitHub OAuth apps allow only ONE callback URL, so for local
# testing create a second "dev" GitHub app with the localhost callback.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── SMTP (password-reset emails) ─────────────────────────────────────────────
# Optional. If SMTP_HOST is left empty the backend runs in DEV MODE: instead of
# emailing the reset link it returns it in the /auth/forgot-password response,
# so you can test the whole reset flow with no email infrastructure.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=<app password>
# EMAIL_FROM=you@gmail.com
